# Copy to web/.env.local (which is git-ignored) and fill in. NAMES ONLY here:
# never put access keys, secret keys or session tokens in this file or commit .env.local.
# Do not prefix any of these with NEXT_PUBLIC_ (that would expose them to the browser).

# Required for POST /api/fit/analyze (live mode). Without them the route returns AI_UNAVAILABLE.
AWS_REGION=
BEDROCK_MODEL_ID=

# Optional: local AWS CLI profile / SSO profile name (a name, not a secret).
# Credentials themselves come from the AWS SDK default provider chain on the server.
AWS_PROFILE=

# Optional tuning (defaults shown)
# BEDROCK_TIMEOUT_MS=45000
# BEDROCK_MAX_OUTPUT_TOKENS=3000

# Live AI switch. Real (paid) Bedrock calls happen ONLY when this is "true" (case-insensitive).
# Unset or any other value: live requests get AI_UNAVAILABLE (503). ?demo=true always works.
# FIT_LIVE_AI_ENABLED=true

# Cost guard for live calls (defaults shown). One SHARED limit for all callers, kept in this
# server process's memory only: not a distributed or per-user limit. A set-but-invalid value
# makes live requests fail closed with 503.
# Allowed ranges: GLOBAL_PER_MIN 1-600 (sliding 60 s), DAILY 1-10000 (sliding 24 h),
# MAX_CONCURRENT 1-20 (extra requests get 429, never queued), BEDROCK_MAX_ATTEMPTS 1-2
# (AWS SDK attempts per request; 1 = no automatic retry).
# FIT_RATE_LIMIT_GLOBAL_PER_MIN=10
# FIT_DAILY_CALL_LIMIT=50
# FIT_MAX_CONCURRENT=2
# BEDROCK_MAX_ATTEMPTS=1

# Private PDF upload preview. Disabled unless ENABLED is exactly true AND a private token
# (at least 32 characters) is configured. Never use NEXT_PUBLIC_ or commit the actual token.
# Origin is the exact browser origin, without trailing slash; defaults to http://localhost:3000.
# Parser path must be absolute; blank uses the local services/resume-parser release executable.
# Docker supplies /usr/local/bin/resume-parser. See docs/RESUME_UPLOAD_INTEGRATION.md.
RESUME_UPLOAD_ENABLED=
RESUME_UPLOAD_TOKEN=
RESUME_UPLOAD_ORIGIN=
RESUME_PARSER_PATH=
